# TLS and routing for the published site.
#
# Two upstreams now instead of one, because the frontend runs its own server:
# Next.js renders the pages, the Node API answers /api, /v1 and /widget. Caddy
# decides which by path.
#
# Order matters — Caddy evaluates `handle` blocks in order, and the bare
# `handle` at the end is the fallback, so the API paths have to be matched
# first or Next would swallow them.

{$SITE_DOMAIN} {
	encode gzip

	# The API. Everything the browser, an installed widget or a customer's own
	# server calls directly.
	#
	#   /api/*     the dashboard and admin, session-cookie authenticated
	#   /v1/*      the public bot API, X-Api-Key authenticated
	#   /widget/*  hosted widget scripts
	#   /health    liveness
	handle /api/* {
		reverse_proxy api:8000 {
			# Disable response buffering. The dashboard assistant streams its
			# reply as server-sent events, and a buffered proxy holds the whole
			# answer until generation finishes — which on a small box is a
			# minute of a blank screen, and is indistinguishable from broken.
			flush_interval -1
		}
	}

	handle /v1/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /widget/* {
		reverse_proxy api:8000
	}

	handle /health {
		reverse_proxy api:8000
	}

	# Everything else is the web app. Server-rendered, so this is a running
	# Next.js server rather than a folder of static files.
	handle {
		reverse_proxy web:3000 {
			flush_interval -1
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
