# ---------------------------------------------------------------------------
# Instant Sahay FAQ Bots — Environment Configuration
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in production values.

# Retrieval confidence thresholds (tune after seeing real query data)
STRONG_MATCH_THRESHOLD=0.85
NEAR_MATCH_THRESHOLD=0.60

# Ollama embedding service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_data

# Number of top results to retrieve
TOP_K=3

# SQLite logging database
SQLITE_DB_PATH=./logs/faq_bot.db

# JWT authentication (HS256)
JWT_SECRET=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256

# Admin API key (for /admin/reindex endpoint — NOT a user credential)
ADMIN_API_KEY=replace-with-a-strong-admin-key

# Rate limiting
RATE_LIMIT_PER_MINUTE=30
