# ---------------------------------------------------------------------------
# Nexora AI — Environment Configuration
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in production values.

# Retrieval confidence thresholds (tune after seeing real query data)
STRONG_MATCH_THRESHOLD=0.85
NEAR_MATCH_THRESHOLD=0.60

# Embedding model (sentence-transformers, runs on CPU)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# How many CPU threads the bot service gives torch. Read by bot-service, not
# by this server; listed here because it comes from the same .env.
#
# Leave it at 2. Torch defaults to one thread per core, and for a 22M-parameter
# model embedding one short sentence the cost of splitting that work across
# cores exceeds the work itself — measured at 273 ms on 12 threads versus 11 ms
# on 2. Raise it only for bulk ingest, where batches are big enough to pay for
# the parallelism.
TORCH_THREADS=2

# How many worker processes the bot service runs. Embedding is the only slow
# thing in the stack, so this is the only knob that changes throughput:
#
#     1 worker  x 2 threads    80 req/s
#     2 workers x 2 threads   132 req/s
#     4 workers x 1 thread    170 req/s
#
# One is right until people are asking concurrently. When you raise it, drop
# TORCH_THREADS to 1 — past one worker they compete for the same cores. Each
# worker holds its own copy of the model, about 400 MB.
BOT_WORKERS=1

# ---------------------------------------------------------------------------
# The two backend services
# ---------------------------------------------------------------------------
# The stack is split: a Node API that the internet talks to, and a Python bot
# service it calls over loopback for retrieval. The API authenticates, meters
# credits and resolves which account is asking; the bot service answers.
#
# Where the API finds it. In Docker this is the compose service name and is set
# for you; set it here only when running the two by hand.
BOT_SERVICE_URL=http://127.0.0.1:8001

# Shared secret between those two. NOT a user credential — it only answers
# "did this come from our own backend". Both services must have the same value.
# Required by docker-compose. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=

# How long the API waits on the bot service. Ingest gets a longer leash because
# embedding a few thousand rows is the slowest thing either service does.
BOT_SERVICE_TIMEOUT_MS=60000
BOT_SERVICE_INGEST_TIMEOUT_MS=300000

# Number of top results to retrieve
TOP_K=3

# MongoDB. Atlas gives you a replica set, which is what multi-document
# transactions need — the credit-spend and referral-payout paths use one where
# it is available and fall back to ordered writes where it is not.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=nexora

# How long to wait for the cluster before failing a request. Atlas is a network
# hop, not a local socket, so this should fail loudly rather than hang a worker.
MONGO_TIMEOUT_MS=8000

# Admin API key. Opens the admin panel at /admin, the support inbox at
# /admin/support, and the key-management routes. It reads every tenant's
# billing, usage and traffic — NOT a user credential, and not a key to paste
# into anything customer-facing.
ADMIN_API_KEY=change-me-in-production

# Username and password for /admin and /admin/support. Signing in gives a
# session that expires after ADMIN_SESSION_HOURS. Leave ADMIN_PASSWORD empty
# to disable password sign-in (the admin key above still works for scripts).
# Generate a password: python -c "import secrets; print(secrets.token_urlsafe(18))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_HOURS=12

# Default daily credit limit for an account with no plan-granted allowance.
# Credits are pooled per account (owner_email), not per API key.
DAILY_CREDIT_LIMIT=250

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

# The hostname Caddy gets a TLS certificate for. Only read when you start with
# the `tls` profile, so it can stay blank on a laptop. See DEPLOY.md.
SITE_DOMAIN=

# ---------------------------------------------------------------------------
# Platform / billing
# ---------------------------------------------------------------------------

# Origins allowed to call the API with a session cookie (comma-separated).
# Must be exact origins — "*" cannot be used with credentialed requests.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The API origin baked into downloaded widget packages and hosted widget
# scripts. Set it when the server sits behind a proxy, e.g. https://api.example.com
# PUBLIC_API_ORIGIN=

# Where the frontend is served from (used to build checkout return URLs)
PUBLIC_BASE_URL=http://localhost:3000

# The API origin written into downloaded widget packages, the hosted widget
# script, and the frontend bundle. On a server this must be your https:// site,
# or widgets installed on customers' HTTPS pages are blocked as mixed content.
PUBLIC_API_ORIGIN=

# manual (development only) | stripe | razorpay
BILLING_PROVIDER=manual

# Lets /api/billing/confirm activate a plan with NO payment. Development only —
# leave false in production or you are giving the product away.
BILLING_ALLOW_MANUAL=false

# ---------------------------------------------------------------------------
# Referrals
# ---------------------------------------------------------------------------
# Rewards land in the *bonus* balance: they never expire and are spent only
# after the day's allowance runs out. Set any of these to 0 to switch that
# payout off without touching the code.

# Paid to the referrer the moment someone signs up with their link or from an
# address they invited.
REFERRAL_REFERRER_CREDITS=100

# Paid to the newcomer, on top of whatever their plan grants.
REFERRAL_REFERRED_CREDITS=50

# Paid to the referrer again on *every* payment that person makes. Keyed on
# the invoice, so a webhook delivered twice still pays once.
REFERRAL_TOPUP_CREDITS=100

# Send the session cookie only over HTTPS. Must be true in production.
BILLING_COOKIE_SECURE=false

# Credits granted per day while a paid plan is active
PAID_DAILY_CREDITS=5000

# Free trial length and its daily allowance
TRIAL_DAYS=14
TRIAL_DAILY_CREDITS=250

# Max active API keys one account may hold
MAX_KEYS_PER_ACCOUNT=10

# ---------------------------------------------------------------------------
# Local model (Ollama) — optional
# ---------------------------------------------------------------------------
# Off by default, and every bot stays verbatim until its owner opts in from
# the dashboard. Two things use it: grounded rewording of near-matches, and
# the owner ops assistant at /v1/owner/ask.
#
# Expected on loopback. That is the data-residency story: the question and the
# sheet rows go to a process on this machine, not to a vendor. Pointing this
# at a remote host gives that up.
LLM_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=20

# Fallback chain. If a model is rate limited (429), busy (503), times out, or
# isn't pulled, the next one is tried. Pull them first:
#   ollama pull qwen2.5:7b && ollama pull llama3.1:8b && ollama pull gemma2:9b
OLLAMA_MODELS=qwen2.5:7b,llama3.1:8b,gemma2:9b

# Last resort once every local model has failed. Hosted: prompts leave this
# machine when Groq answers. Leave GROQ_API_KEY empty to stay fully local.
GROQ_API_KEY=
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30

# Gemini, after Groq. Several keys, comma-separated: each model is tried on
# every key before the next model (free-tier quotas are per project per
# model). Hosted: prompts leave this machine when Gemini answers.
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30

# Which providers are tried, and in what order. Remove one to switch it off.
LLM_PROVIDER_ORDER=ollama,groq,gemini

# Seconds a rate-limited or failing model is skipped before it's retried.
LLM_COOLDOWN_SECONDS=60
# Seconds a key the provider rejects outright (invalid/revoked) is skipped.
LLM_BAD_KEY_COOLDOWN_SECONDS=3600

# Faithful rephrasing, not writing. Creativity is the failure mode here.
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=400
LLM_MAX_INPUT_CHARS=2000

# Fraction of a generated answer's content words that must trace back to the
# retrieved rows, or it is discarded and the verbatim answer is sent instead.
LLM_MIN_GROUNDEDNESS=0.72

# ---------------------------------------------------------------------------
# The dashboard assistant
# ---------------------------------------------------------------------------
# A general-purpose chat assistant for signed-in customers, in the web app
# only. No API key can reach it — customers integrate a bot that answers from
# their sheet, and that contract does not change.
#
# Independent of LLM_ENABLED: that one only offers bot owners the rewording
# toggle. This one is the chat window.
ASSISTANT_ENABLED=false

# Defaults to OLLAMA_MODEL. Sharing one model avoids holding two in memory,
# which on a 12 GB box is the difference between comfortable and swapping.
# ASSISTANT_MODEL=qwen2.5:7b

# Generation is slow on CPU, and the reply streams, so the ceiling is generous.
ASSISTANT_TIMEOUT_SECONDS=180
ASSISTANT_TEMPERATURE=0.7
ASSISTANT_MAX_TOKENS=1024

# Turns of history sent with each message. More context costs a CPU real time
# on every turn, and a 7B model loses the thread before it runs out of window.
ASSISTANT_HISTORY_TURNS=12
ASSISTANT_MAX_MESSAGE_CHARS=4000

# Two cores generate for one person at a time. Extra requests queue, then are
# turned away with a reason rather than making everyone slower.
ASSISTANT_CONCURRENCY=1
ASSISTANT_QUEUE_WAIT_SECONDS=45
ASSISTANT_DAILY_MESSAGES=100

# ---------------------------------------------------------------------------
# Firebase Authentication — server side (the admin credential)
# ---------------------------------------------------------------------------
# This is the service account that VERIFIES the ID token a browser brings back
# from a Firebase sign-in. It is a private key: it can mint credentials for any
# user in the project. It belongs in this file and nowhere else — never in the
# frontend bundle, never committed, never pasted into a chat or an issue.
#
# The PEM's newlines are written as literal backslash-n because a .env file
# cannot hold a real multi-line value; config.py unescapes them on load.
#
# Rotate at: console.cloud.google.com/iam-admin/serviceaccounts (project
# nexoraai-d42ae) -> this account -> Keys -> Add key, then delete the old one.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Alternative to the three variables above: the whole downloaded JSON on one
# line. Handy for a secret manager that stores blobs. If set, it wins.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Refuse a sign-in whose email Firebase has not confirmed. Leave this on:
# it is the only thing stopping someone who types an address they do not own
# from being matched into the account that does own it.
FIREBASE_REQUIRE_VERIFIED_EMAIL=true

# Clock drift allowed when checking an ID token's timestamps.
FIREBASE_CLOCK_SKEW_SECONDS=30

# ---------------------------------------------------------------------------
# Firebase Web app config — the browser half (NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------
# These are PUBLIC by design. Vite inlines every NEXT_PUBLIC_* variable into the
# JavaScript bundle, so treat them as published the moment you deploy. That is
# fine and expected: a Firebase web apiKey is a project identifier, not a
# secret. What actually protects your data is Firebase Auth + Security Rules,
# plus the API key restrictions you set in the Google Cloud console.
#
# Never put the service account key above into a NEXT_PUBLIC_ variable.
#
# Get these from: Firebase Console -> Project Settings -> General ->
# Your apps -> Web app -> SDK setup and configuration -> Config.
# Register a web app first if none exists.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nexoraai-d42ae.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nexoraai-d42ae
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nexoraai-d42ae.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Analytics only runs when this is set — it is the GA4 measurement id, the
# "G-XXXXXXXXXX" from the same config block. Without it the app still works;
# every track() call simply becomes a no-op.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Turn the browser SDKs on and off independently. Performance Monitoring adds
# a second script and samples real user traces; Analytics is the event
# pipeline. Both default on when the config above is filled in.
NEXT_PUBLIC_FIREBASE_ANALYTICS_ENABLED=true
NEXT_PUBLIC_FIREBASE_PERFORMANCE_ENABLED=true

# Echoed on every crash report and analytics event so a spike can be pinned to
# a deploy. Set it to the git SHA in CI.
NEXT_PUBLIC_APP_RELEASE=dev

# ---------------------------------------------------------------------------
# Client telemetry (the web stand-in for Crashlytics)
# ---------------------------------------------------------------------------
# Crashlytics has no Web SDK. The page logs a GA4 `exception` event and POSTs
# the stack trace to /api/telemetry/error, which lands in MongoDB with a TTL.
TELEMETRY_ENABLED=true
TELEMETRY_MAX_ERRORS_PER_IP_PER_HOUR=60
TELEMETRY_RETENTION_DAYS=30
