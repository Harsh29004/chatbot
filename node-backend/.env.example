# Nexora AI — Node backend configuration.
#
# Every variable keeps the name it had in the Python build, so the project-root
# .env works against this server unchanged. That file is read first; a .env in
# this directory is read second and wins, which is handy while both stacks are
# running side by side. Real environment variables beat both.
#
# Only the "Python bot service" block below is new. The retrieval settings that
# follow it are read by that service, not this one — they are listed here
# because they come from the same file and belong to the same product.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Browsers refuse to send a session cookie to a wildcard origin, so the web
# origins are listed explicitly. Next.js dev runs on :3000.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where the browser reaches this API. Used to build checkout return URLs and
# referral links.
PUBLIC_BASE_URL=http://localhost:3000

# Pins the origin baked into generated widget scripts. Behind a reverse proxy
# the request's own host is the internal address, which is not what a
# customer's website should call.
PUBLIC_API_ORIGIN=

# How many proxies sit in front of this server. Without it every rate limiter
# keys on the proxy's address and throttles the whole internet as one client.
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=nexora
MONGO_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# The Python bot service (NEW)
# ---------------------------------------------------------------------------
# Retrieval, sheet ingest, templates and the widget. Bind it to loopback: it
# has no user-facing authentication because it has no users — this server
# resolves who is asking before forwarding anything to it.
BOT_SERVICE_URL=http://127.0.0.1:8001

# Shared secret, sent on every internal call. Not a user credential — it only
# answers "did this come from our own backend". Set the same value in the bot
# service's environment. Leave both blank on a laptop; set both in production.
INTERNAL_API_KEY=

BOT_SERVICE_TIMEOUT_MS=60000
# Embedding a few thousand rows is the slowest thing either service does, so
# the upload path gets a longer leash than the rest.
BOT_SERVICE_INGEST_TIMEOUT_MS=300000

# Must match what the bot service loads. This server compares the two at
# startup and warns loudly on a mismatch, because a silent mismatch shows up
# much later as "search stopped finding anything".
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
STRONG_MATCH_THRESHOLD=0.85
NEAR_MATCH_THRESHOLD=0.60
TOP_K=3

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Change both of these before deploying.
ADMIN_API_KEY=admin-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_HOURS=12

# OWASP's 2023 floor. Lower it (e.g. 10000) for fast local signups only —
# existing hashes keep verifying at whatever count they were written with.
PBKDF2_ITERATIONS=600000

SESSION_COOKIE_NAME=nexora_session
# Set both of these when serving over TLS.
COOKIE_SECURE=false
BILLING_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Credits
# ---------------------------------------------------------------------------
DAILY_CREDIT_LIMIT=250
MAX_KEYS_PER_ACCOUNT=10

# ---------------------------------------------------------------------------
# Billing
# ---------------------------------------------------------------------------
BILLING_CURRENCY=USD
PAID_DAILY_CREDITS=5000
TRIAL_DAILY_CREDITS=250
TRIAL_DAYS=14
ENTITLEMENT_SWEEP_SECONDS=900

# manual | stripe | razorpay. "manual" takes no payment; BILLING_ALLOW_MANUAL
# must also be true before it will activate anything, so it cannot become a
# free-access hole in production by accident.
BILLING_PROVIDER=manual
BILLING_ALLOW_MANUAL=false

# ---------------------------------------------------------------------------
# Referrals
# ---------------------------------------------------------------------------
REFERRAL_REFERRER_CREDITS=100
REFERRAL_REFERRED_CREDITS=50
REFERRAL_TOPUP_CREDITS=100

# ---------------------------------------------------------------------------
# Signup policy
# ---------------------------------------------------------------------------
BLOCK_DISPOSABLE_EMAILS=true
DISPOSABLE_EMAIL_DOMAINS=
MAX_SIGNUPS_PER_IP_PER_DAY=3

# ---------------------------------------------------------------------------
# Firebase Authentication (server side)
# ---------------------------------------------------------------------------
# Either the whole service-account JSON on one line...
FIREBASE_SERVICE_ACCOUNT_JSON=
# ...or the three fields that matter. The private key keeps its literal \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

FIREBASE_CLOCK_SKEW_SECONDS=30
# Leave this on. Off, anyone who can type an address into your sign-up form can
# take over the account that already owns it.
FIREBASE_REQUIRE_VERIFIED_EMAIL=true

# ---------------------------------------------------------------------------
# Local LLM — optional, off unless explicitly enabled
# ---------------------------------------------------------------------------
# Only used for grounded rewording on the near band, and the owner ops
# assistant. Retrieval never needs it.
LLM_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODELS=qwen2.5:7b,llama3.1:8b,gemma2:9b
OLLAMA_TIMEOUT_SECONDS=20

# Groq and Gemini are HOSTED. When either answers, the prompt — including
# retrieved sheet rows — has left this machine. Leave the keys unset to stay
# entirely local.
GROQ_API_KEY=
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash

LLM_PROVIDER_ORDER=ollama,groq,gemini
LLM_COOLDOWN_SECONDS=60
LLM_BAD_KEY_COOLDOWN_SECONDS=3600
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=400
LLM_MAX_INPUT_CHARS=2000
# 0.0 accepts anything a model writes; 1.0 accepts only near-verbatim copies.
LLM_MIN_GROUNDEDNESS=0.72

# ---------------------------------------------------------------------------
# Dashboard assistant
# ---------------------------------------------------------------------------
ASSISTANT_ENABLED=false
ASSISTANT_MODEL=
ASSISTANT_TIMEOUT_SECONDS=180
ASSISTANT_TEMPERATURE=0.7
ASSISTANT_MAX_TOKENS=1024
ASSISTANT_HISTORY_TURNS=12
ASSISTANT_MAX_MESSAGE_CHARS=4000
ASSISTANT_CONCURRENCY=1
ASSISTANT_QUEUE_WAIT_SECONDS=45
ASSISTANT_DAILY_MESSAGES=100

# ---------------------------------------------------------------------------
# Client crash reporting
# ---------------------------------------------------------------------------
TELEMETRY_ENABLED=true
TELEMETRY_MAX_ERRORS_PER_IP_PER_HOUR=60
TELEMETRY_RETENTION_DAYS=30
