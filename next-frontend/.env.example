# Nexora AI — Next.js frontend configuration.
#
# Copy to .env.local. Next exposes NEXT_PUBLIC_* to the browser bundle at build
# time (the way Vite exposed VITE_*); everything else stays server-side.

# ---------------------------------------------------------------------------
# Where the API is
# ---------------------------------------------------------------------------
# Used by next.config.mjs to rewrite /api, /v1, /widget and /health. The browser
# only ever talks to this origin, which is what keeps the session cookie
# first-party and SameSite=Lax sufficient.
API_ORIGIN=http://127.0.0.1:8000

# Where Server Components reach the API. Usually the same, but in a container
# this is the internal address — going back out through the public URL and in
# again would be a pointless second hop, and the public name may not even
# resolve from inside.
INTERNAL_API_ORIGIN=http://127.0.0.1:8000

# The origin customers' own servers and installed widgets should call, shown in
# the dashboard's copy-pasteable snippets. Defaults to this site's origin.
NEXT_PUBLIC_PUBLIC_API_ORIGIN=

# ---------------------------------------------------------------------------
# Firebase (browser half)
# ---------------------------------------------------------------------------
# Public by design. A Firebase web apiKey is a project identifier, not a secret
# — access is controlled by Auth, Security Rules and API key restrictions. The
# service account private key is a different thing entirely and belongs only in
# the API server's environment.
#
# Leave these blank to disable Firebase sign-in; the app falls back to the
# email+password endpoint and hides the Google button.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Build identity
# ---------------------------------------------------------------------------
# Echoed on every analytics event and crash report, so a spike can be traced to
# the deploy that caused it. Set it to the commit sha in CI.
NEXT_PUBLIC_APP_RELEASE=dev
